import serial
import struct

ser = serial.Serial("/dev/ttyS0", 9600, timeout=1)

def read_pms7003():
    while True:
        # look for the PMS header
        if ser.read(1) == b'\x42':
            if ser.read(1) == b'\x4d':
                frame = ser.read(30)
                if len(frame) == 30:
                    data = b'\x42\x4d' + frame
                    return data

def parse_pms7003(frame):
    fields = struct.unpack(">2sHHHHHHHHHHHHH", frame[:32])

    pm1_0_cf1   = fields[2]
    pm2_5_cf1   = fields[3]
    pm10_cf1    = fields[4]
    pm1_0_env   = fields[5]
    pm2_5_env   = fields[6]
    pm10_env    = fields[7]

    return pm1_0_env, pm2_5_env, pm10_env

while True:
    frame = read_pms7003()
    # 
pm1, pm25, pm10 = parse_pms7003(frame)
    # print(f"PM1.0={pm1}, PM2.5={pm25}, PM10={pm10}")
